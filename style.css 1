/* Reset default browser spacing */
body { 
    margin: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f2f2f2;
    color:#334e64
}
/*Navigation*/
nav {
    background-color:rgb(255, 255, 255);
    color:black;
    font-family: Georgia, 'Times New Roman', Times, serif,serif;
    letter-spacing: 1px;
    background-size: 100%;
    position: right;
    font-size:15px;
    margin: 0px;
    padding: 0px;
    border-style: solid;
    border-width: 1px;
    border-color:#4a1818;
    border-radius: 8px;
    }
nav a {
   color: black;
   font-weight: bold;
   border-style: solid;
   border-width: 1px;
   border-color:black;
   border-radius: 4px;
   padding-right: 2px;
   padding-left: 4px;
   gap: 1px;
}

 nav img {
    border: 0px solid #f5f5f0;
    margin: 0px;
 }
 /*Header*/
 header {
   margin-top: 9%;
   text-align: center;
 }
 /*Main content*/

   main p{
    padding: 10px;
    background-color:#f2f2f2;
    color:#334e64;
    padding-top: 10px;
    font-style: italic;
    font-size: 20px;
    font-weight: normal;
    text-align:left;
 }
 main h1{
    font-weight: bold;
    font-size: 30px;
    background-color:#f2f2f2;
    color:#334e64;
    padding-top: 10px;
    font-style: italic;
 }
 main h2{
      font-weight: normal;
      font-size: 25px;
      background-color:#f2f2f2;
      color:#334e64;
      padding-top: 10px;
      font-style: italic;
 }

  main img{
   width:100%;
   height: 400px;
   display: block;
   border: 20px solid #f2f2f2;
   object-fit: cover;
   background-size: contain;
  }
/* Custom primary button */
.btn-custom {
   color: black;
   background-color:#e7d1f3;
   text-decoration: none;
   text-align: center;
   font-weight:bold;
   font-size: 16px;
   border-radius: 5px;
   padding: 10px 24px;
   border-width: 1px;
   border-color: black;
   border-style: solid;
}
 

/*Our Services*/
header {
    text-align: center;
    font-size: 20px;
    margin-top: 10%;
}

<!--Main Content-->
div.polaroid {
   display:flex;
   width: 38%;
   background-color: white ;
   background-size:contain;
   box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19);
   margin-bottom: 20px;
   margin:50px;
   gap:10px;
}

div.container {
   background-color: white;
   width:100%;
   gap: 20px;
   flex-wrap: wrap;
   padding: 10px 20px;
   margin:0px;
}


/*Footer*/
footer {
   background-color:#e7e4e1;
   font-size: 20px;
   color: #334e64;
   padding: 10px;
   text-align: left;
   font-weight: normal;
   position: auto;
   width: 100%;
 }